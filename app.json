{
  "expo": {
    "name": "Reid",
    "slug": "reid-native",
    "scheme": "reid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tbxgrows.reid",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Reid will let you know when he has something for you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628"
      },
      "package": "com.tbxgrows.reid"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#B91C1C"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a4e8058-8d22-4a0a-b057-8ad821dab3f2"
      }
    }
  }
}
